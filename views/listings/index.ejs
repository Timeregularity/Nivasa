<% layout("layouts/boilerplate") %>
<section class="listing-hero container">
  <div class="hero-copy-block"><p class="eyebrow">STAYNEST / FIND YOUR VIBE</p><h1>Find a stay that<br><span>matches your vibe.</span></h1><p class="hero-intro">Search naturally, explore unique places, and plan smarter with StayNest.</p><a class="hero-assistant-link" href="/assistant"><i class="fa-solid fa-sparkles" aria-hidden="true"></i> Meet your AI travel copilot <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
  <div class="hero-orbit" aria-hidden="true"><span></span><i class="fa-solid fa-location-arrow"></i></div>
</section>
<section class="container discovery-searches" aria-label="Search stays">
  <form class="nlp-search-panel" data-ai-search action="/ai/nlp-search" method="post">
    <div class="search-panel-icon"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></div><div><label for="indexAiQuery">AI PROPERTY SEARCH</label><input id="indexAiQuery" name="query" type="search" placeholder="Luxury villa in Goa under ₹5,000 with a pool" required autocomplete="off"><small>Try a mood, budget, destination, or group size.</small></div><button class="btn btn-ai" type="submit">Ask StayNest AI <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button><p class="ai-search-status visually-hidden" aria-live="polite"></p>
  </form>
  <form class="availability-search" action="/listings/search" method="get" novalidate>
    <div class="destination-control" data-city-autocomplete><label for="exploreLocation">OR SEARCH BY CITY</label><div class="destination-input"><i class="fa-solid fa-location-arrow" aria-hidden="true"></i><input id="exploreLocation" name="country" type="text" placeholder="Enter a city or country" required autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="city-suggestion-list" aria-activedescendant=""><span class="search-loader d-none" aria-hidden="true"></span></div><ul id="city-suggestion-list" class="city-suggestions" role="listbox" aria-label="City suggestions" hidden></ul><p class="search-status visually-hidden" aria-live="polite"></p></div><button class="btn btn-primary" type="submit">Search location <i class="fa-solid fa-arrow-right"></i></button>
  </form>
</section>
<section class="container listing-content"><div class="listing-topline"><p><span class="result-count"><%= allListing.length %></span> places in the collection</p><div class="filters" aria-label="Listing categories"><a href="/listings">All</a><a href="/listings/category/Trending">Trending</a><a href="/listings/category/Hills">Hills</a><a href="/listings/category/Coastal">Coastal</a><a href="/listings/category/Camping">Camping</a><a href="/listings/category/Rooms">Rooms</a></div></div><% if(allListing.length){ %><div class="stay-grid"><% allListing.forEach((list) => { %><article class="stay-card"><a class="stay-image" href="/listings/<%= list._id %>"><img src="<%= (list.img && list.img.url) || 'https://via.placeholder.com/900x700?text=StayNest' %>" alt="<%= list.title %>"><span class="image-index"><%= String(allListing.indexOf(list) + 1).padStart(2, '0') %></span></a><div class="stay-details"><span class="stay-category"><%= list.category %></span><h2><a href="/listings/<%= list._id %>"><%= list.title %></a></h2><p class="stay-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= list.location %><% if(list.country){ %>, <%= list.country %><% } %></p><div class="stay-footer"><span>From <b>₹<%= Number(list.price).toLocaleString('en-IN') %></b> / night</span><a href="/listings/<%= list._id %>" aria-label="View <%= list.title %>"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></div></div></article><% }) %></div><% } else { %><div class="empty-state"><i class="fa-solid fa-compass"></i><h2>No stays found</h2><p>Try another city, region, or category.</p><a class="btn btn-primary" href="/listings">View all stays</a></div><% } %></section>
