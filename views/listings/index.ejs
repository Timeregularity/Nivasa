<% layout("layouts/boilerplate") %>
<body>
<section class="browse-heading">
  <p class="eyebrow">CURATED STAYS</p>
  <h1>Find a place you’ll love</h1>
  <p>Explore memorable homes, scenic escapes, and comfortable stays.</p>
</section>
<section class="ai-tools mb-4" id="tripPlanner">
  <div>
    <p class="eyebrow">AI TRIP PLANNER</p>
    <h3>Plan your stay</h3>
    <p class="text-muted">Tell us your destination, days, group size, and total budget.</p>
  </div>
  <form id="tripPlannerForm" class="row g-2">
    <div class="col-md-4"><input class="form-control" name="destination" placeholder="Destination" required></div>
    <div class="col-md-2"><input class="form-control" name="days" type="number" min="1" max="30" placeholder="Days" required></div>
    <div class="col-md-2"><input class="form-control" name="travelers" type="number" min="1" max="20" placeholder="Guests" required></div>
    <div class="col-md-2"><input class="form-control" name="budget" type="number" min="500" placeholder="Budget INR" required></div>
    <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Plan with AI</button></div>
  </form>
  <div id="tripPlanOutput" class="ai-output" aria-live="polite"></div>
</section>
<span>

</span>
<div class="filters mt-2">
  <div class="filter">
   <a href="/listings/category/Trending"><i class="fa-solid fa-fire "></i> <br>
    Trending</a>
  </div>
  <div class="filter">
    <a href="/listings/category/Hills"><i class="fa-solid fa-mountain "></i><br>
      Hills</a>
  </div>
  <div class="filter">
    <a href="/listings/category/Snow"><i class="fa-solid fa-snowflake "></i><br>
      Snow</a>
  </div>
  <div class="filter">
    <a href="/listings/category/Iconic Cities"><i class="fa-solid fa-mountain-city "></i><br>
      Iconic Cities</a>
  </div>
  <div class="filter">
    <a href="/listings/category/Rooms"><i class="fa-solid fa-bed "></i><br>
      Rooms</a>
  </div>
  <div class="filter">
   <a href="/listings/category/Coastal"><i class="fa-solid fa-umbrella-beach "></i><br>
    Coastal</a>
  </div>
  
 <div class="filter"><a href="/listings/category/Camping">
  <i class="fa-solid fa-campground "></i><br>Camping
 </a></div>
</div> 
<div class="cards-hotels">
    <% let i=0;%>
 <% for(let list of allListing){ %>
    <% i++; %>
  <a href="/listings/<%= list._id %>" style="text-decoration: none;">
    <div class="card card-<%= i %>">
     <img src="<%= list.img.url%>" class="card-img-top" alt="...">
     <div class="card-body">
     <h5 class="card-title"><%= list.title %></h5>
     <p class="card-text">₹<%= list.price %>/night</p>
   
  </div>
</div>
</a>
 <%
} %>
 
</div>
</body>
