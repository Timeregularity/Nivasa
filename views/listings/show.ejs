<% layout("layouts/boilerplate") %>

<body>
   <% if(error && error.length){ %>
      <div class="alert alert-danger alert-dismissible fade show col-10 col-md-6 mx-auto mt-3" role="alert">
         <%= error[0] %>
         <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
   <% } %>

   <% if(listing) { %>
   <div class="container show-page">

      <div class="card show-card">
         <img src="<%= (listing.img.url && (typeof listing.img === 'string' ? listing.img : listing.img.url)) || 'https://via.placeholder.com/300x200?text=Image+Not+Available' %>" class="card-img-top show-img" alt="image">

         <div class="card-body">
            <h2 class="card-title"><%= listing.title %></h2>
            <p class="card-text"><%= listing.description %>.</p>
            <p class="card-text">₹ <%= listing.price.toLocaleString("en-IN") %>/night</p>
            <p class="card-text"><%= listing.location %></p>
            <p class="card-text"><%= listing.country %></p>
            <p class="card-text">Owned By <%= listing.owner ? listing.owner.username : 'Unknown' %></p>

            <% if(currentUser && listing.owner && listing.owner._id.toString() == currentUser._id.toString()) { %>
               <div class="show-actions">
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>

                  <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                     <button class="btn btn-dark">Delete this Listing</button>
                  </form>
               </div>
            <% } %>
         </div>
      </div>
   

      <% if (currentUser && currentUser.role !== 'owner' && listing.owner && listing.owner._id.toString() !== currentUser._id.toString()) { %>
      <section class="booking-panel" data-booking-panel data-listing-id="<%= listing._id %>" data-nightly-price="<%= listing.price %>">
         <div><p class="eyebrow">BOOK THIS STAY</p><h3>Choose your dates.</h3><p>Send a request to the owner. Your total updates before you confirm.</p></div>
         <form action="/bookings/listings/<%= listing._id %>" method="post" class="booking-form">
            <label>Check in<input type="date" name="booking[checkIn]" class="form-control" required></label>
            <label>Check out<input type="date" name="booking[checkOut]" class="form-control" required></label>
            <label>Guests<input type="number" name="booking[guests]" class="form-control" min="1" max="20" value="1" required></label>
            <label class="booking-notes">Notes <span>optional</span><textarea name="booking[notes]" class="form-control" rows="2" maxlength="500" placeholder="Anything the owner should know?"></textarea></label>
            <div class="booking-calculation"><span id="bookingAvailability">Select dates to check availability.</span><b id="bookingTotal">₹0</b></div>
            <button type="submit" class="btn btn-ai" disabled>Send booking request <i class="fa-solid fa-arrow-right"></i></button>
         </form>
      </section>
      <% } else if (!currentUser) { %>
      <section class="booking-panel booking-login"><div><p class="eyebrow">PLAN A STAY</p><h3>Dates, guests, then you’re set.</h3><p>Log in to check availability and send a booking request.</p></div><a href="/login" class="btn btn-ai">Log in to book</a></section>
      <% } %>

      <section class="ai-tools mb-4" data-listing-id="<%= listing._id %>">
         <div>
            <div class="ai-tool-kicker"><p class="eyebrow">AI TRAVEL TOOLS</p><span class="ai-tool-badge"><i class="fa-solid fa-sparkles" aria-hidden="true"></i> StayNest intelligence</span></div>
            <h3>Make a faster booking decision</h3>
            <p class="text-muted mb-3">Get a review summary or discover stays with a similar feel.</p>
            <div class="ai-tool-actions"><button type="button" class="btn btn-outline-dark btn-sm" id="summarizeReviews"><i class="fa-regular fa-message" aria-hidden="true"></i> Summarize reviews</button>
            <button type="button" class="btn btn-outline-dark btn-sm" id="findSimilarListings"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Find similar stays</button></div>
         </div>
         <div id="aiReviewSummary" class="ai-output" aria-live="polite"></div>
         <div id="similarListings" class="ai-similar-list"></div>
      </section>

      <hr>

      <% if(currentUser && canReview){ %>
      <div class="review-form-section mb-4 mt-3">
         <h3>Leave a review</h3>
         <form novalidate class="needs-validation" action="/listings/<%= listing._id %>/reviews" method="post">
            <div class="mt-2">
               <label for="Rating">Rating:</label>
               <input class="form-control" name="review[rating]" type="range" min="1" max="5">
            </div>

            <div class="mb-2 mt-3">
               <label for="comment">Comment:</label>
               <textarea name="review[comment]" class="form-control" id="comment" rows="5" cols="30"></textarea>
            </div>

            <div class="mb-2" style="display: none;">
               <label for="author">Author:</label>
               <input class="form-control" name="review[author]" type="text" value="<%= currentUser._id %>">
            </div>

            <button class="btn btn-outline-dark">Submit</button>
         </form>
      </div>
      <% } %>

      <hr>

      <div class="avg-review">
         <%
            let total = 0;
            let length = listing.reviews.length;

            for(let ratings of listing.reviews){
               total += ratings.rating;
            }

            let avg = length > 0 ? (total / length).toFixed(1) : 0;
         %>

         <h1><%= avg %></h1>
         <span style="color: rgb(255, 242, 0); font-size: 18pt;">
            <% for (let i = 1; i <= avg; i++) { %>
               <%= '★' %>
            <% } %>

            <% if(avg % 1 != 0){ %>
               <%= '⯪' %>
            <% } %>

            <% for (let i = 1; i <= 5 - avg; i++) { %>
               <%= '☆' %>
            <% } %>
         </span>

         <h6>Total Reviews: <%= length %></h6>
      </div>

      <h3 class="mt-4">All Reviews</h3>

      <div class="reviews-list">
         <% for(let ratings of listing.reviews){ %>
            <div class="card border mb-3 mt-3">
               <div class="card-body">
                  <b>Rating: </b>
                  <span style="color: rgb(255, 242, 0); font-size: 18pt;">
                     <% for (let i = 1; i <= 5; i++) { %>
                        <%= i <= ratings.rating ? '★' : '☆' %>
                     <% } %>
                  </span>
                  <br>

                  <b>Remarks: </b><%= ratings.comment %><br>

                  <span style="font-size: 10pt;">
                     <%= ratings.createdAt ? ratings.createdAt.toDateString() : "" %>
                  </span>

                  <form action="/listings/<%= listing._id %>/reviews/<%= ratings._id %>?_method=DELETE" method="POST" class="mt-2">
                     <button class="btn btn-outline-dark btn-sm">Delete</button>
                  </form>
               </div>
            </div>
         <% } %>
      </div>

   </div>
   <% } %>
</body>
