<% layout("layouts/boilerplate") %>

<body>
    
        <div class="container mt-5 offset-2">
            <div class="card shadow-sm p-4" style="max-width: 600px;">
              <h2 class="mb-4">Create New Listing</h2>
              <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data" >  
            
                <div class="mb-3 mt-3">
                    <label for="title" >Title: </label><br>
                    <input id="title" name="listing[title]" type="text" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid title.</div><br><br>
                </div>
               
               <div class="mb-3">
                <label for="img" >Upload Listing Image: </label><br>
                <input name="listing[img]" type="file" class="form-control"  required>
                <div class="invalid-feedback">Please upload a file.</div><br><br>
               </div>
                <div class="mb-3">
                  <label for="price" >Price: </label><br>
                  <input id="price" name="listing[price]" type="number" class="form-control" required>
                  <div class="invalid-feedback">Please enter a valid price.</div><br><br>
                </div>
                <div class="mb-3">
                    <label for="location" >Location: </label><br>
                    <input id="location" name="listing[location]" type="text" class="form-control" required>
                    <div class="invalid-feedback">Please enter a valid location.</div><br><br>
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                  
                    <select id="category" name="listing[category]" class="form-select" required>
                  
                      <option value="Trending">Trending</option>
                  
                      <option value="Rooms" >Rooms</option>
                  
                      <option value="Iconic Cities" >Iconic Cities</option>
                  
                      <option value="Hills" >Hills</option>
                  
                      <option value="Coastal" >Coastal</option>
                  
                      <option value="Camping" >Camping</option>
                  
                      <option value="Snow">Snow</option>
                  
                    </select>
                  </div>
                <div class="mb-3">
                    <label for="country" >Country: </label><br>
                    <input id="country" name="listing[country]" type="text" class="form-control" required>
                    <div class="invalid-feedback">Please enter a valid country.</div><br><br>
                </div>
                <div class="mb-3">

                  <div class="d-flex justify-content-between align-items-center">
              
                      <label for="description">Description</label>
              
                      <button
                          type="button"
                          id="generateDescription"
                          class="btn btn-outline-dark btn-sm">
              
                          ✨ Generate with AI
              
                      </button>
              
                  </div>
              
                  <textarea
                      id="description"
                      name="listing[description]"
                      class="form-control mt-2"
                      rows="6"
                      required></textarea>
              
                  <div class="invalid-feedback">
                      Please enter a valid description.
                  </div>
              
                  <div
                      id="loading"
                      class="text-center mt-3"
                      style="display:none;">
              
                      <div class="spinner-border spinner-border-sm"></div>
              
                      <p class="mt-2">Generating AI description...</p>
              
                  </div>
              
              </div>
                
                <button type="submit" class="btn btn-dark">Submit</button>
            </form>
            </div>
          </div>
</body>
