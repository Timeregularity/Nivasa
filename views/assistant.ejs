d placeholder="2"></label><label>Budget (₹)<input name="budget" type="number" min="500" required placeholder="15000"></label></div><button class="btn btn-ai" type="submit"><span>Plan with AI</span><i class="fa-solid fa-arrow-up"></i></button></form><div class="assistant-typing d-none" id="assistantTyping"><span></span><span></span><span></span> StayNest AI is thinking</div><div class="assistant-result d-none" id="assistantResult" aria-live="polite"></div></section></div></section>
