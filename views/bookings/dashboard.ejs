<% layout("layouts/boilerplate") %>
<section class="container booking-dashboard"><header class="booking-dashboard-head"><div><p class="eyebrow"><%= isOwner ? 'OWNER CONTROL ROOM' : 'YOUR STAYNEST' %></p><h1><%= isOwner ? 'Your places, in motion.' : 'Your trips, all in one place.' %></h1><p><%= isOwner ? 'Live booking activity and availability based on your actual listing data.' : 'Every booking request and trip status, in one clear timeline.' %></p></div><a class="btn btn-ai" href="<%= isOwner ? '/listings/new' : '/listings' %>"><%= isOwner ? 'Add a listing' : 'Explore stays' %> <i class="fa-solid fa-arrow-right"></i></a></header>
<% if(isOwner){ %><div class="metric-grid"><div><span>Total listings</span><b><%= metrics.listingCount %></b></div><div><span>Pending requests</span><b><%= metrics.pendingCount %></b></div><div><span>Confirmed stays</span><b><%= metrics.confirmedCount %></b></div><div><span>Booking revenue</span><b>₹<%= metrics.revenue.toLocaleString('en-IN') %></b></div><div><span>30-day occupancy</span><b><%= metrics.occupancy %>%</b></div></div><div class="dashboard-columns"><section class="dashboard-panel"><div class="panel-title"><h2>Booking requests</h2><span><%= bookings.length %> total</span></div><% if(bookings.length){ %><div class="booking-list"><% bookings.forEach((booking)=>{ %><article class="booking-row"><div><b><%= booking.listing ? booking.listing.title : 'Deleted listing' %></b><small><%= booking.customer ? booking.customer.username : 'Customer' %> · <%= booking.checkIn.toLocaleDateString('en-IN') %> — <%= booking.checkOut.toLocaleDateString('en-IN') %></small></div><div class="booking-row-meta"><span class="booking-status <%= booking.status %>"><%= booking.status %></span><b>₹<%= booking.totalPrice.toLocaleString('en-IN') %></b></div><% if(booking.status === 'pending'){ %><div class="booking-actions"><form action="/bookings/<%= booking._id %>/status" method="post"><input type="hidden" name="status" value="confirmed"><button class="btn btn-primary btn-sm">Accept</button></form><form action="/bookings/<%= booking._id %>/status" method="post"><input type="hidden" name="status" value="cancelled"><button class="btn btn-outline-dark btn-sm">Reject</button></form></div><% } %></article><% }) %></div><% } else { %><p class="empty-copy">No booking activity yet.</p><% } %></section><section class="dashboard-panel"><div class="panel-title"><h2>Blocked availability</h2><span><%= blockedDates.length %> ranges</span></div><% if(blockedDates.length){ %><div class="blocked-list"><% blockedDates.forEach((block)=>{ %><div><b><%= block.listing ? block.listing.title : 'Deleted listing' %></b><small><%= block.startDate.toLocaleDateString('en-IN') %> — <%= block.endDate.toLocaleDateString('en-IN') %></small></div><% }) %></div><% } else { %><p class="empty-copy">No dates are blocked.</p><% } %></section></div><% } else { %><section class="dashboard-panel customer-bookings"><div class="panel-title"><h2>Your booking timeline</h2><span><%= bookings.length %> total</span></div><% if(bookings.length){ %><div class="booking-list"><% bookings.forEach((booking)=>{ %><article class="booking-row"><div><b><%= booking.listing ? booking.listing.title : 'Deleted listing' %></b><small><%= booking.checkIn.toLocaleDateString('en-IN') %> — <%= booking.checkOut.toLocaleDateString('en-IN') %> · <%= booking.guests %> guests</small></div><div class="booking-row-meta"><span class="booking-status <%= booking.status %>"><%= booking.status %></span><b>₹<%= booking.totalPrice.toLocaleString('en-IN') %></b></div><% if(['pending','confirmed'].includes(booking.status)){ %><form action="/bookings/<%= booking._id %>/cancel" method="post"><button class="btn btn-outline-dark btn-sm">Cancel booking</button></form><% } %></article><% }) %></div><% } else { %><div class="empty-booking"><i class="fa-solid fa-sparkles"></i><h2>Your next stay starts here.</h2><p>Explore the collection and send your first booking request.</p><a class="btn btn-ai" href="/listings">Browse stays</a></div><% } %></section><% } %></section>
