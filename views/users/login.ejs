<% layout("layouts/boilerplate") %>
<section class="container"><div class="auth-card"><p class="eyebrow">WELCOME BACK</p><h2>Come on in.</h2><p>Pick up where your last escape left off.</p><% if(error && error.length){ %><div class="alert alert-danger mt-3"><%= error[0] %></div><% } %><form action="/login" method="POST" novalidate class="needs-validation mt-4"><div class="mb-3"><label class="form-label" for="username">Username</label><input id="username" name="username" type="text" class="form-control" required autofocus><div class="invalid-feedback">Please enter your username.</div></div><div class="mb-4"><label class="form-label" for="password">Password</label><input id="password" name="password" type="password" class="form-control" required><div class="invalid-feedback">Please enter your password.</div></div><button type="submit" class="btn btn-primary w-100">Log in <i class="fa-solid fa-arrow-right ms-1"></i></button></form><p class="mt-4 mb-0">New to StayNest? <a class="text-link" href="/signUp">Create an account</a></p><i class="creator-signature auth-signature">K.</i></div></section>
