<% layout("layouts/boilerplate") %>
<% if(currentUser) { %><section class="container dashboard-page"><div class="dashboard-intro"><p class="eyebrow">YOUR PROFILE</p><h1>Good to see you, <em><%= currentUser.username %>.</em></h1><p>Manage your details and continue exploring the collection.</p></div><div class="profile-summary"><span class="profile-avatar"><%= currentUser.username.charAt(0).toUpperCase() %></span><div><h2><%= currentUser.username %></h2><p><%= currentUser.email %></p></div><a class="btn btn-primary ms-auto" href="/listings">Browse stays</a></div></section><% } else { %><script>window.location.href='/login';</script><% } %>
